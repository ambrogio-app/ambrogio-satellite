{
  "name": "ambrogio-satellite",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "bin": {
    "ambrogio-satellite": "dist/main.js"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "test": "vitest run",
    "test:backend": "pnpm build && node scripts/verify-backend.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "dependencies": {
    "decibri": "5.8.0",
    "onnxruntime-node": "1.30.0",
    "pino": "10.4.0"
  }
}

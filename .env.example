# Local environment file for development: copy it to .env, fill in the values and start the
# satellite with `pnpm dev`, which loads .env with `node --env-file=.env`. Variables already set in the
# environment take precedence over the file. Empty variables count as unset: the satellite then applies
# its own defaults, described in the configuration reference.
AMBROGIO_ENV=development
AMBROGIO_BACKEND_URL=
AMBROGIO_CLIENT_ID=
AMBROGIO_CLIENT_NAME=
AMBROGIO_MICROPHONE=
AMBROGIO_SPEAKER=
AMBROGIO_ATTENUATION_DEVICE=
AMBROGIO_ATTENUATION_CONTROL=
AMBROGIO_ATTENUATION_LEVEL=
AMBROGIO_WAKE_WORD_MODEL=
AMBROGIO_WAKE_WORD_THRESHOLD=
AMBROGIO_WAKE_WORD_PATIENCE=
AMBROGIO_REPLY_TIMEOUT_MS=

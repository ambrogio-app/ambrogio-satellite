#!/bin/sh
# Block commits that add secrets. Enable once per clone: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not on PATH, so the commit is blocked." >&2
  echo "Install gitleaks 8.30.1 (https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1)," >&2
  echo "put it on PATH and keep the hook enabled with: git config core.hooksPath .githooks" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
